<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:validation="http://www.mulesoft.org/schema/mule/validation" xmlns:db="http://www.mulesoft.org/schema/mule/db" xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd 
http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd">
    <http:listener-config name="scarpefrl-httpListenerConfig">
        <http:listener-connection host="0.0.0.0" port="8081" />
    </http:listener-config>
    <apikit:config name="scarpefrl-config" api="scarpefrl.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
    <db:config name="Database_Config" doc:name="Database Config" doc:id="ddc08b44-be83-4e64-91d1-a31298bcc937" >
		<db:generic-connection url="jdbc:postgresql://localhost:5432/ScarpeDB" driverClassName="org.postgresql.Driver" user="postgres" password="postgres" />
	</db:config>
	<flow name="scarpefrl-main">
        <http:listener config-ref="scarpefrl-httpListenerConfig" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="scarpefrl-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:BAD_REQUEST">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Bad request"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Method not allowed"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">405</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_ACCEPTABLE">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not acceptable"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">406</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:UNSUPPORTED_MEDIA_TYPE">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Unsupported media type"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">415</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_IMPLEMENTED">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not Implemented"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">501</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="scarpefrl-console">
        <http:listener config-ref="scarpefrl-httpListenerConfig" path="/console/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="scarpefrl-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="patch:\spedizioni\(id_sped):application\json:scarpefrl-config">
        <ee:transform doc:name="Transform Message">
            <ee:variables>
                <ee:set-variable variableName="id_sped">attributes.uriParams.'id_sped'</ee:set-variable>
            </ee:variables>
        </ee:transform>
        <ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
"\"Aggiornamento registrato\"" as String {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
    <flow name="get:\clienti\(id_cliente):scarpefrl-config">
        <set-payload value="#[attributes.uriParams]" doc:name="Set Payload" doc:id="cdd87983-46e5-42cb-8dd5-8d8da376af62" />
		<ee:transform doc:name="Transform Message">
            <ee:variables>
                <ee:set-variable variableName="id_cliente">attributes.uriParams.'id_cliente'</ee:set-variable>
            </ee:variables>
        </ee:transform>
        <ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  id: 1,
  nome: "Pittarosso",
  mail: "pittarosso@gmail.com",
  telefono: "3351267890",
  indirizzo: "Via indipendenza 13, Roma"
} as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
    <flow name="post:\ordini:application\json:scarpefrl-config">
		<flow-ref doc:name="Flow Reference" doc:id="d3eca3e1-7b7e-491f-b507-8f979a67e0da" name="validazione_ordine"/>
		<db:insert doc:name="Insert" doc:id="1e803853-b470-4099-8432-1e3a90e10424" config-ref="Database_Config">
			<db:sql ><![CDATA[
INSERT INTO scarpe.ordini(id_ord, id_cliente, id_prod, qta_ord, data_ord, data_vol, data_max, stato_ord)
VALUES (:id_ord, :id_cliente, :id_prod, :qta_ord, :data_ord, :data_vol, :data_max, :stato_ord)]]></db:sql>
			<db:input-parameters ><![CDATA[#[{id_ord: payload.id_ord , 
id_cliente: payload.id_cliente, 
id_prod: payload.id_prod, 
qta_ord: payload.qta_ord, 
data_ord: payload.data_ordine as LocalDateTime,
data_vol: payload.data_voluta as LocalDateTime,
data_max: payload.data_massima as LocalDateTime,
stato_ord: payload.stato_ord
}]]]></db:input-parameters>
		</db:insert>
		<logger level="INFO" doc:name="Logger" doc:id="479fbd12-5cbc-48f2-87e9-a8d561183ec9" message="#[testttttttt]"/>
    </flow>
    <flow name="validazione_ordine" doc:id="c89f88c0-3508-4fb8-b05b-690052ab2ead" >
		<set-variable value="#[payload]" doc:name="dati_ordine" doc:id="3ed973d7-aa53-4eb6-9404-78088d3557b6" variableName="dati_ordine"/>
		<db:select doc:name="controllo_IDordine" doc:id="ebda3ad7-f74d-4d21-8877-f4a4012e5e41" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT id_ord FROM scarpe.ordini WHERE id_ord = :id]]></db:sql>
			<db:input-parameters ><![CDATA[#[id: payload.id_ord]]]></db:input-parameters>
		</db:select>
		<validation:is-empty-collection doc:name="Is empty collection" doc:id="9b867585-5d21-405c-afc2-b294652aac3b"/>
		<db:select doc:name="controllo_IDcliente" doc:id="29f4245f-883c-4730-b6f1-dced764af832" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT id_cliente FROM scarpe.clienti WHERE id_cliente = :id]]></db:sql>
			<db:input-parameters ><![CDATA[#[id: vars.dati_ordine.id_cliente]]]></db:input-parameters>
		</db:select>
		<set-variable value="#['errore_IDcliente']" doc:name="check_errore" doc:id="fd2bc1f4-bf68-4f30-a8e1-bc79ecf6da41" variableName="check_errore"/>
		<validation:is-not-empty-collection doc:name="Is not empty collection" doc:id="600a8d8a-69e1-44df-9c99-0a4767c7a7f3" message="#['errore_IDcliente']"/>
		<db:select doc:name="controllo_IDprodotto" doc:id="ee8abb7a-b86a-4ea9-b3ee-387873e3942a" config-ref="Database_Config">
			<db:sql ><![CDATA[SELECT id_prod FROM scarpe.prodotti WHERE id_prod = :id]]></db:sql>
			<db:input-parameters ><![CDATA[#[id: vars.dati_ordine.id_prod]]]></db:input-parameters>
		</db:select>
		<set-variable value="#['errore_IDprod']" doc:name="check_errore" doc:id="451f23eb-33f1-4ca5-9000-3d87141c1897" variableName="check_errore"/>
		<validation:is-not-empty-collection doc:name="Is not empty collection" doc:id="cd428792-a862-429f-9e64-c5abfa6ee42f" message="#['errore_IDprod']"/>
		<error-handler >
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="60ea6f76-a6e3-4606-9a27-34919b665462" type="VALIDATION:NOT_EMPTY_COLLECTION" >
				<set-variable value="400" doc:name="Set Variable" doc:id="756347d4-c226-4bbe-a72d-fe288a27c99e" variableName="httpStatus" />
				<set-payload value="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;  Errore: &quot;L'id è già presente sul database.&quot; &#10;}]" doc:name="Set Payload" doc:id="77ca60b3-18ea-4304-8fc5-3c14a803adb3" />
			</on-error-propagate>
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="834d4198-63ab-4b91-bf86-b030dc7928b2" type="VALIDATION:EMPTY_COLLECTION">
				<set-variable value="404" doc:name="Set Variable" doc:id="a13d5f35-b239-45a2-9ff7-ddcb8f308a13" variableName="httpStatus" />
				<choice doc:name="Choice" doc:id="733ebf80-3056-4cce-8c9a-bd5a98cec0e9" >
					<when expression="#[error.description == 'errore_IDcliente']">
						<set-payload value="#['Il cliente non è registrato nel database']" doc:name="Set Payload" doc:id="b4420954-1ad3-4183-873c-99891995a9c8" />
					</when>
					<when expression="#[error.description == 'errore_IDprod']">
						<set-payload value="#['Il prdotto non è registrato nel datanase']" doc:name="Set Payload" doc:id="cf3dac3b-3bdf-4707-bda9-77440930cf84" />
					</when>
				</choice>
			</on-error-propagate>
		</error-handler>
	</flow>
	<flow name="post:\spedizioni:application\json:scarpefrl-config">
        <ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
"Spedizione registrata" as String {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
</mule>
